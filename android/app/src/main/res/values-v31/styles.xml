<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ replaced the old launch-window splash with the Splash Screen
      API, which ignores `windowBackground` entirely and instead composites
      `windowSplashScreenAnimatedIcon` over `windowSplashScreenBackground`.
      Without this override the system falls back to the theme's colorBackground
      — white on a light-mode device — so the dark launch_background above is
      never seen on a modern phone.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/lc_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lc_background</item>
    </style>
</resources>
