<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app is dark-only, so both the light and night variants of these
      themes are dark. Inheriting Theme.Light here (as the template does) makes
      the launch window white on a device in light mode, which cold-starts as a
      white flash before the near-black UI paints.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Removed automatically once the engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applies once the process has started, and stays behind the Flutter UI
         for the life of the activity. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lc_background</item>
    </style>
</resources>
